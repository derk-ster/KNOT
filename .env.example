# Copy to .env (never commit .env)

# --- AI (optional, Groq, server-side only) ---
# Without a key the AI Finder tab is disabled and matching/help fall back to local rules.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Shared database (optional but recommended for the real demo) ---
# Any Postgres connection string. With Supabase: Project Settings > Database >
# Connection string > "Transaction" pooler (port 6543), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# When set, every computer and the deployed site share the same groups and messages.
# The schema is created automatically on first use. When unset, data stays in data/db.json
# (local file; on Vercel, groups live in each visitor's browser).
DATABASE_URL=
