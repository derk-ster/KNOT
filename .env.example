# Copy to .env (never commit .env)

# --- AI (optional, server-side only). OpenAI is used when its key is set; Groq is the fallback. ---
# Without any key, matching/help fall back to local rules and everything else still works.
OPENAI_API_KEY=
# The model names must be set explicitly (no invented defaults):
OPENAI_MODEL=
OPENAI_FAST_MODEL=
# Moderation model for held messages (default omni-moderation-latest):
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# Groq fallback:
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- AI budget (spend tracking for every model call) ---
# KNOT_AI_BUDGET_USD=25
# KNOT_AI_WARN_USD=20
# KNOT_AI_STOP_USD=23
# KNOT_AI_MAX_CALLS_DAY=600        # call-count cap when a model has no known pricing
# KNOT_AI_PRICING={"my-model":{"in":0.25,"out":2.0}}   # dollars per 1M tokens

# --- Shared database (optional but recommended for the real demo) ---
# Any Postgres connection string. With Supabase: Project Settings > Database >
# Connection string > "Transaction" pooler (port 6543), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# When set, every computer and the deployed site share the same groups, accounts and messages.
# The schema is created automatically on first use (additive only; no data is ever dropped).
# When unset, data stays in data/db.json (local file; on Vercel, groups live in each visitor's
# browser and accounts/discovery are unavailable).
DATABASE_URL=

# --- Admin console (optional) ---
# Lets organizers read reports and the moderation log at /api/admin/reports?key=...
# ADMIN_KEY=
